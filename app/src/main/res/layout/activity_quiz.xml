<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingTop="?attr/actionBarSize"
    android:paddingBottom="24dp"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:background="@color/white"
    tools:context=".QuizActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <!-- cabeçalho (timer e n° da questao) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:weightSum="1">

            <TextView
                android:id="@+id/question_indicator_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Questão 1/10"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_timer"
                    app:tint="@color/blue"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/timer_indicator_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5:46"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue" />
            </LinearLayout>
        </LinearLayout>

        <!-- indicador de progresso -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/question_progress_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            app:trackColor="@color/gray"
            app:indicatorColor="@color/orange"
            tools:progress="40" />

        <!-- área rolavel -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:elevation="3dp"
                app:cardCornerRadius="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/question_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:text="O que é o sistema operacional Android?"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="@color/blue"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp" />

<!--                alternativas-->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/rounded_gray_button"
                    android:backgroundTint="@null"
                    android:text="Resposta A"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/rounded_gray_button"
                    android:backgroundTint="@null"
                    android:text="Resposta B"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/rounded_gray_button"
                    android:backgroundTint="@null"
                    android:text="Resposta C"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/rounded_gray_button"
                    android:backgroundTint="@null"
                    android:text="Resposta D"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp" />




                <!-- botões próxima e "?" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="10">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/hint_btn"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="2"
                        android:text="?"
                        android:textSize="18sp"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_regular"
                        android:background="@drawable/rounded_gray_button"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="2dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/next_btn"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="8"
                        android:text="Próxima"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/white"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/rounded_orange_button" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
    </LinearLayout>
    </LinearLayout>
