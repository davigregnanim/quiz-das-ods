<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="80dp"
    android:background="@drawable/bg_gradient_categorias"
    android:fitsSystemWindows="true"
    tools:context=".OdsInfoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/odsHeaderImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ods"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="26dp"
            android:elevation="2dp"
            android:clipToOutline="true" />

        <TextView
            android:id="@+id/odsIntroText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/black"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="26dp"
            android:textAlignment="center"
            tools:text="As ODS (Objetivos de Desenvolvimento Sustentável) foram criadas pela ONU em 2015 para promover um futuro mais justo e equilibrado para todos." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
