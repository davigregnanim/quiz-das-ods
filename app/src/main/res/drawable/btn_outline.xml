<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- estado pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#66BB6A" />
            <stroke android:width="2dp" android:color="#66BB6A" />
            <corners android:radius="12dp" />
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="4dp"
                android:bottom="4dp" />
        </shape>
    </item>

    <!-- estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#43A047" />
            <stroke android:width="2dp" android:color="#43A047" />
            <corners android:radius="12dp" />
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="4dp"
                android:bottom="4dp" />
        </shape>
    </item>

</selector>
