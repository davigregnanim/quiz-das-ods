<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E07B00"/> <!-- laranja um pouco mais escuro -->
            <stroke android:width="2dp" android:color="#E07B00"/>
            <corners android:radius="12dp" />
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="4dp"
                android:bottom="4dp" />
        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/orange"/> <!-- laranja padrão -->
            <stroke android:width="2dp" android:color="@color/orange"/>
            <corners android:radius="12dp" />
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="4dp"
                android:bottom="4dp" />
        </shape>
    </item>

</selector>
